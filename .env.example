# Copy to .env at the repo root: cp .env.example .env
# Every app and package reads this single root file.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=ficc
POSTGRES_PASSWORD=ficc
POSTGRES_DB=ficc
# Host port for Postgres. Change it (and DATABASE_URL) if 5432 is already taken.
POSTGRES_PORT=5432

# --- Redis (docker-compose.yml): job queue and Socket.IO adapter ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Key prefix of the job queue (lets several environments share one Redis)
QUEUE_PREFIX=ficc

# --- Database (Prisma, used by packages/db and apps/api) ---
DATABASE_URL=postgresql://ficc:ficc@localhost:5432/ficc?schema=public

# --- API (apps/api) ---
API_PORT=4000
# Origin allowed by CORS (the web app)
WEB_ORIGIN=http://localhost:3000
# Secrets (32+ chars). Development falls back to built-in values; production must set them.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-for-access-tokens
GUEST_PASS_SECRET=change-me-to-a-different-long-random-string-for-guest-qr
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Set when web and API live on sibling subdomains, e.g. .club.com.br
# COOKIE_DOMAIN=
# Defaults to true in production
# COOKIE_SECURE=false
# Background jobs on BullMQ (booking expiry, lesson generation, auto-approve, LGPD retention)
JOBS_ENABLED=true
# Club this deployment serves (v1 is one club per deployment)
DEFAULT_CLUB_SLUG=ficc
# Encrypts guest document numbers at rest (LGPD): 32 bytes, base64 (openssl rand -base64 32).
# Development falls back to a built-in key; production must set its own and keep it safe:
# losing it makes stored documents unreadable.
# DATA_ENCRYPTION_KEY=
# e2e tests use DATABASE_URL with "_test" appended unless this is set
# DATABASE_URL_TEST=postgresql://ficc:ficc@localhost:5432/ficc_test?schema=public

# --- Web (apps/web) ---
# Where the browser calls the API. Locally the API itself. In production leave it EMPTY and set
# API_INTERNAL_URL: the web app then proxies /api/v1 and /socket.io to the API (one origin, so the
# login cookies work on any host). Both are read when the web app is built.
NEXT_PUBLIC_API_URL=http://localhost:4000
# API_INTERNAL_URL=http://api.railway.internal:4000

# --- Seed (packages/db) ---
# Password for every seeded account (local development only).
SEED_PASSWORD=ficc1234
# The seed refuses NODE_ENV=production (it wipes every table) unless this is "yes": only for a
# demo deployment, with its own SEED_PASSWORD. The real club uses `pnpm db:bootstrap` instead.
# SEED_ALLOW_WIPE=

# --- Production setup (`pnpm db:bootstrap`, once, on an empty database) ---
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=
