{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".env"],
  "globalEnv": [
    "ACCESS_TOKEN_TTL_MINUTES",
    "API_PORT",
    "COOKIE_DOMAIN",
    "COOKIE_SECURE",
    "DATABASE_URL",
    "DATABASE_URL_TEST",
    "GUEST_PASS_SECRET",
    "JOBS_ENABLED",
    "JWT_ACCESS_SECRET",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SHOW_DEV_PAGES",
    "NODE_ENV",
    "REFRESH_TOKEN_TTL_DAYS",
    "SEED_PASSWORD",
    "WEB_ORIGIN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "generated/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "db:seed": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
