// Prisma schema (see docs/SPEC.md, "DATA MODEL" and "MULTI-CLUB STRATEGY").
//
// Tenancy
// - v1 serves only FICC, but every club-owned table carries `clubId` and is read and written
//   through the API's tenant Prisma extension, which filters and stamps it automatically.
//   Child rows that only exist under a club-owned parent (CoachCourt, BookingPlayer,
//   MatchPlayer, MatchSet, CourtFreezeCourt, UserCategory) inherit the club from it.
// - `clubId` defaults to the session setting `app.club_id`, which is never set: the default only
//   exists so Prisma's generated input types treat clubId as optional (the extension always
//   stamps it). A write that escapes the extension gets NULL and fails the NOT NULL constraint.
// - Club rules live in ClubSettings.values (validated by clubSettingsSchema in @ficc/shared).
//
// Conventions
// - Instants are timestamptz (UTC). Calendar days are `@db.Date` and always mean the club-local
//   date in the club's time zone (Club.timezone); the slot's start time comes from TimeSlot.
// - Rows that carry history (lessons, bookings, matches, ratings, scans) are never hard-deleted
//   through their parents: those relations use `Restrict` or `SetNull`.
// - CHECK constraints that Prisma cannot express live in the migration SQL and are listed in the
//   comment of each model they protect.

generator client {
  provider = "prisma-client-js"
  // Generated inside this package so every consumer imports it from @ficc/db
  // and Turborepo can cache it as a build output.
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

