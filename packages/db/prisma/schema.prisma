// ─── Clubs ──────────────────────────────────────────────────────────────────

/// A club served by the platform. v1 resolves it from DEFAULT_CLUB_SLUG; later from a subdomain.
model Club {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  /// IANA time zone for every club-local date and time, e.g. "America/Sao_Paulo".
  timezone     String
  /// UI and message locale, e.g. "pt-BR".
  locale       String
  logoUrl      String?
  /// Brand colors (#RRGGBB) for the club's theming.
  primaryColor String?
  accentColor  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  settings             ClubSettings?
  categories           Category[]
  users                User[]
  validMembershipIds   ValidMembershipId[]
  refreshTokens        RefreshToken[]
  coaches              Coach[]
  courts               Court[]
  timeSlots            TimeSlot[]
  occupancies          SlotOccupancy[]
  lessonSeries         LessonSeries[]
  lessons              Lesson[]
  lessonAuditLogs      LessonAuditLog[]
  bookings             Booking[]
  slotFavorites        SlotFavorite[]
  freezes              CourtFreeze[]
  matches              Match[]
  ratings              PlayerRating[]
  eloHistory           EloHistory[]
  guestPasses          GuestPass[]
  guestBlocks          GuestBlock[]
  gateScans            GateScanLog[]
  notifications        Notification[]
  tournaments          Tournament[]
  tournamentCategories TournamentCategory[]
  tournamentEntries    TournamentEntry[]
  tournamentGroups     TournamentGroup[]
  tournamentMatches    TournamentMatch[]
  announcements        TournamentAnnouncement[]
  circuits             Circuit[]
  circuitCategories    CircuitCategory[]
  scheduleExceptions   ScheduleException[]
  checkIns             CourtCheckIn[]
  queueEntries         CourtQueueEntry[]
  slotHolds            SlotHold[]
  staffRoles           StaffRole[]
  auditLogs            AuditLog[]
  noShows              NoShow[]
  newsPosts            NewsPost[]
}

/// The club's configurable rules. `values` holds the fields of clubSettingsSchema
/// (@ficc/shared); missing fields fall back to DEFAULT_CLUB_SETTINGS, so adding a setting needs
/// no data migration.
model ClubSettings {
  clubId    String   @id
  values    Json     @default("{}")
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

/// A club's competitive categories (FICC: Classe A, B, C, Feminino, Sênior).
model Category {
  id        String   @id @default(cuid())
  clubId    String   @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  /// Stable identifier used by the APIs, e.g. "CLASS_A".
  key       String
  name      String
  sortOrder Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  club    Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  members UserCategory[]

  @@unique([clubId, key])
}

// ─── People & access ────────────────────────────────────────────────────────

/// Any account: member, coach, admin or gate staff.
/// CHECK: members must have a membershipId; every user has a login (membershipId or email).
model User {
  id                         String     @id @default(cuid())
  clubId                     String     @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  role                       Role       @default(MEMBER)
  /// Matrícula, digits only, unique within the club. Members log in with it.
  membershipId               String?
  /// Login for staff accounts (coach, admin, gate), unique within the club.
  email                      String?
  passwordHash               String
  name                       String
  photoUrl                   String?
  isActive                   Boolean    @default(true)
  /// Set by an admin to stop this member from creating guest passes.
  guestPassesSuspendedAt     DateTime?  @db.Timestamptz(3)
  guestPassesSuspendedReason String?
  /// Self sign-ups start PENDING when the club requires approval.
  status                     UserStatus @default(ACTIVE)
  rejectionReason            String?
  reviewedAt                 DateTime?  @db.Timestamptz(3)
  reviewedById               String?
  /// Set by the no-show penalty: no new bookings until then.
  bookingSuspendedUntil      DateTime?  @db.Timestamptz(3)
  createdAt                  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime   @updatedAt @db.Timestamptz(3)

  club                       Club                     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  membership                 ValidMembershipId?       @relation(fields: [clubId, membershipId], references: [clubId, membershipId], onDelete: Restrict, onUpdate: Cascade)
  categories                 UserCategory[]
  ratings                    PlayerRating[]
  coach                      Coach?
  refreshTokens              RefreshToken[]
  bookingsCreated            Booking[]                @relation("BookingCreatedBy")
  bookingPlayers             BookingPlayer[]
  slotFavorites              SlotFavorite[]
  matchPlayers               MatchPlayer[]
  matchesReported            Match[]                  @relation("MatchReportedBy")
  matchesResponded           Match[]                  @relation("MatchRespondedBy")
  matchesResolved            Match[]                  @relation("MatchResolvedBy")
  eloHistory                 EloHistory[]
  guestPasses                GuestPass[]
  guestBlocksCreated         GuestBlock[]             @relation("GuestBlockBlockedBy")
  guestBlocksLifted          GuestBlock[]             @relation("GuestBlockLiftedBy")
  gateScans                  GateScanLog[]
  freezesCreated             CourtFreeze[]            @relation("FreezeCreatedBy")
  freezesLifted              CourtFreeze[]            @relation("FreezeLiftedBy")
  lessonAuditLogs            LessonAuditLog[]
  notifications              Notification[]
  tournamentsCreated         Tournament[]             @relation("TournamentCreatedBy")
  organizing                 TournamentOrganizer[]
  tournamentEntries          TournamentEntryPlayer[]
  announcements              TournamentAnnouncement[]
  reportedTournamentResults  TournamentMatch[]        @relation("TournamentResultReportedBy")
  confirmedTournamentResults TournamentMatch[]        @relation("TournamentResultConfirmedBy")
  reviewedBy                 User?                    @relation("UserReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewed                   User[]                   @relation("UserReviewedBy")
  staffRoles                 UserStaffRole[]
  checkIns                   CourtCheckInPlayer[]
  checkInsCreated            CourtCheckIn[]           @relation("CheckInCreatedBy")
  queueEntries               CourtQueueEntry[]
  slotHolds                  SlotHold[]
  noShows                    NoShow[]                 @relation("NoShowUser")
  noShowsMarked              NoShow[]                 @relation("NoShowMarkedBy")
  newsPosts                  NewsPost[]
  newsReactions              NewsReaction[]
  newsReads                  NewsRead[]
  auditLogs                  AuditLog[]
  exceptionsCreated          ScheduleException[]

  @@unique([clubId, membershipId])
  @@unique([clubId, email])
  @@index([clubId, role])
}

/// Categories a member plays in.
model UserCategory {
  userId     String
  categoryId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
}

/// Membership IDs allowed to register (imported by the admin, e.g. from CSV).
/// User.membershipId references this table, so an account can only use a listed ID.
model ValidMembershipId {
  id           String   @id @default(cuid())
  clubId       String   @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  membershipId String
  /// Name on the club's records, to help members recognise their ID.
  holderName   String?
  /// Inactive IDs can no longer be used to register.
  isActive     Boolean  @default(true)
  importedAt   DateTime @default(now()) @db.Timestamptz(3)

  club Club  @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user User?

  @@unique([clubId, membershipId])
}

/// Rotating refresh tokens (stored hashed). Reusing a revoked token revokes its whole family.
model RefreshToken {
  id        String    @id @default(cuid())
  clubId    String    @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  userId    String
  familyId  String
  tokenHash String    @unique
  userAgent String?
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// Coach profile of a COACH user.
model Coach {
  id          String   @id @default(cuid())
  clubId      String   @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  userId      String   @unique
  displayName String
  photoUrl    String?
  /// Hex color used for the coach's accents in calendars.
  color       String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  club          Club           @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  allowedCourts CoachCourt[]
  lessonSeries  LessonSeries[]
  lessons       Lesson[]
}

/// Courts a coach may schedule lessons on.
model CoachCourt {
  coachId String
  courtId String

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)
  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@id([coachId, courtId])
  @@index([courtId])
}

// ─── Courts & schedule grid ─────────────────────────────────────────────────

model Court {
  id        String      @id @default(cuid())
  clubId    String      @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  /// "Q1" … "Q6", unique within the club.
  name      String
  surface   Surface
  sport     Sport
  status    CourtStatus @default(ACTIVE)
  sortOrder Int
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)

  club              Club               @relation(fields: [clubId], references: [id], onDelete: Restrict)
  coachCourts       CoachCourt[]
  lessonSeries      LessonSeries[]
  lessons           Lesson[]
  bookings          Booking[]
  occupancies       SlotOccupancy[]
  favorites         SlotFavorite[]
  freezes           CourtFreezeCourt[]
  matches           Match[]
  tournamentMatches TournamentMatch[]
  checkIns          CourtCheckIn[]
  queueOffers       CourtQueueEntry[]
  slotHolds         SlotHold[]

  @@unique([clubId, name])
}

/// One slot of the club's daily grid (admin-editable; seeded from the club's data).
/// Retire a slot with isActive = false: past bookings and lessons keep pointing at it.
/// CHECK: startTime is "HH:mm" and durationMinutes > 0.
model TimeSlot {
  id              String   @id @default(cuid())
  clubId          String   @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  /// "HH:mm", club local time.
  startTime       String   @db.VarChar(5)
  durationMinutes Int      @default(75)
  sortOrder       Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  club              Club              @relation(fields: [clubId], references: [id], onDelete: Restrict)
  lessonSeries      LessonSeries[]
  lessons           Lesson[]
  bookings          Booking[]
  occupancies       SlotOccupancy[]
  favorites         SlotFavorite[]
  tournamentMatches TournamentMatch[]
  slotHolds         SlotHold[]

  @@unique([clubId, startTime])
}

// ─── Slot occupancy: the single double-booking guard ────────────────────────
//
// Every live use of a court on a date and slot (a PENDING or CONFIRMED booking, or a SCHEDULED
// lesson) owns exactly one SlotOccupancy row, inserted in the same transaction that creates the
// booking or lesson. The primary key is (courtId, date, timeSlotId), so a second claim on the
// same cell fails with a unique violation (Prisma P2002) no matter which table it comes from:
// a lesson and a booking can never hold the same court + date + slot, even under concurrent
// requests. Cancelling deletes the row (the booking or lesson stays as history), which frees the
// slot immediately; moving a lesson deletes the old row and inserts a new one.
//
// CHECK: exactly one of bookingId / lessonId is set.

model SlotOccupancy {
  clubId            String   @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  courtId           String
  date              DateTime @db.Date
  timeSlotId        String
  bookingId         String?  @unique
  lessonId          String?  @unique
  /// A scheduled tournament match claims its slot like a booking or a lesson.
  tournamentMatchId String?  @unique
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  club            Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  court           Court            @relation(fields: [courtId], references: [id], onDelete: Restrict)
  timeSlot        TimeSlot         @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  booking         Booking?         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lesson          Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  tournamentMatch TournamentMatch? @relation(fields: [tournamentMatchId], references: [id], onDelete: Cascade)

  @@id([courtId, date, timeSlotId])
  @@index([date])
}

// ─── Lessons ────────────────────────────────────────────────────────────────

/// Recurring lesson rule. Calendars never read series directly: a scheduled job materialises
/// Lesson occurrences for a rolling 8-week window and records how far it got in generatedUntil.
/// CHECK: at least one weekday; endDate (inclusive), when set, is not before startDate.
model LessonSeries {
  id             String    @id @default(cuid())
  clubId         String    @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  coachId        String
  courtId        String
  timeSlotId     String
  weekdays       Weekday[]
  startDate      DateTime  @db.Date
  /// Last date (inclusive). Null = open-ended. "Cancel this and all future" sets it.
  endDate        DateTime? @db.Date
  /// Default for generated occurrences.
  studentNames   String?
  note           String?
  /// Last date for which occurrences have been generated.
  generatedUntil DateTime? @db.Date
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  club      Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  coach     Coach            @relation(fields: [coachId], references: [id], onDelete: Restrict)
  court     Court            @relation(fields: [courtId], references: [id], onDelete: Restrict)
  timeSlot  TimeSlot         @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  lessons   Lesson[]
  auditLogs LessonAuditLog[]

  @@index([coachId])
  @@index([courtId, timeSlotId])
}

/// A concrete lesson on one date: generated from a series, or one-off (seriesId = null).
/// A SCHEDULED lesson holds a SlotOccupancy row; cancelling deletes it and keeps this row, which
/// also stops the series job from re-creating the occurrence (unique seriesId + date).
model Lesson {
  id           String       @id @default(cuid())
  clubId       String       @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  seriesId     String?
  coachId      String
  courtId      String
  timeSlotId   String
  date         DateTime     @db.Date
  status       LessonStatus @default(SCHEDULED)
  studentNames String?
  note         String?
  cancelledAt  DateTime?    @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  club      Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  series    LessonSeries?    @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  coach     Coach            @relation(fields: [coachId], references: [id], onDelete: Restrict)
  court     Court            @relation(fields: [courtId], references: [id], onDelete: Restrict)
  timeSlot  TimeSlot         @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  occupancy SlotOccupancy?
  auditLogs LessonAuditLog[]

  @@unique([seriesId, date])
  @@index([date, courtId])
  @@index([coachId, date])
}

/// Who changed which lesson or series, and how. Survives deletion of the lesson or series.
model LessonAuditLog {
  id        String            @id @default(cuid())
  clubId    String            @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  lessonId  String?
  seriesId  String?
  actorId   String
  action    LessonAuditAction
  /// Before/after values or other context for the change.
  details   Json?
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  club   Club          @relation(fields: [clubId], references: [id], onDelete: Restrict)
  lesson Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  series LessonSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  actor  User          @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([lessonId])
  @@index([seriesId])
  @@index([actorId])
  @@index([createdAt])
}

// ─── Bookings ───────────────────────────────────────────────────────────────

/// Member court booking. PENDING until every tagged player confirms; any decline, or no answer
/// by expiresAt (2 h), cancels it and frees the slot. PENDING and CONFIRMED bookings hold a
/// SlotOccupancy row.
model Booking {
  id           String               @id @default(cuid())
  clubId       String               @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  type         BookingType
  status       BookingStatus        @default(PENDING)
  courtId      String
  timeSlotId   String
  date         DateTime             @db.Date
  createdById  String
  /// Pending bookings are cancelled by the scheduled job after this instant.
  expiresAt    DateTime             @db.Timestamptz(3)
  confirmedAt  DateTime?            @db.Timestamptz(3)
  cancelledAt  DateTime?            @db.Timestamptz(3)
  cancelReason BookingCancelReason?
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)

  club        Club            @relation(fields: [clubId], references: [id], onDelete: Restrict)
  court       Court           @relation(fields: [courtId], references: [id], onDelete: Restrict)
  timeSlot    TimeSlot        @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  createdBy   User            @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  players     BookingPlayer[]
  occupancy   SlotOccupancy?
  matches     Match[]
  guestPasses GuestPass[]
  noShows     NoShow[]

  @@index([date, courtId])
  @@index([status, expiresAt])
  @@index([createdById])
}

/// A tagged player (2 for singles, 4 for doubles, creator included) and their answer.
model BookingPlayer {
  bookingId   String
  userId      String
  status      BookingPlayerStatus @default(PENDING)
  respondedAt DateTime?           @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([bookingId, userId])
  @@index([userId, status])
}

/// Court + slot a member watches; they are notified whenever it opens up on any date.
model SlotFavorite {
  id         String   @id @default(cuid())
  clubId     String   @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  userId     String
  courtId    String
  timeSlotId String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  club     Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  court    Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  timeSlot TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)

  @@unique([userId, courtId, timeSlotId])
  @@index([courtId, timeSlotId])
}

// ─── Court freezes (rain / maintenance) ─────────────────────────────────────

/// One freeze event (one court, a whole surface, or all courts). Active while
/// startsAt <= now < endsAt (or endsAt is null) and liftedAt is null.
/// CHECK: surface is set exactly when scope = SURFACE; endsAt, when set, is after startsAt.
model CourtFreeze {
  id          String       @id @default(cuid())
  clubId      String       @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  reason      FreezeReason
  scope       FreezeScope
  surface     Surface?
  startsAt    DateTime     @db.Timestamptz(3)
  /// Null = until an admin lifts it.
  endsAt      DateTime?    @db.Timestamptz(3)
  liftedAt    DateTime?    @db.Timestamptz(3)
  note        String?
  createdById String
  liftedById  String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  club      Club               @relation(fields: [clubId], references: [id], onDelete: Restrict)
  courts    CourtFreezeCourt[]
  createdBy User               @relation("FreezeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  liftedBy  User?              @relation("FreezeLiftedBy", fields: [liftedById], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([liftedAt, endsAt])
}

/// Courts covered by a freeze event.
model CourtFreezeCourt {
  freezeId String
  courtId  String

  freeze CourtFreeze @relation(fields: [freezeId], references: [id], onDelete: Cascade)
  court  Court       @relation(fields: [courtId], references: [id], onDelete: Restrict)

  @@id([freezeId, courtId])
  @@index([courtId])
}

// ─── Matches & rating ───────────────────────────────────────────────────────

/// Reported result. PENDING until an opponent approves (CONFIRMED) or disputes (DISPUTED);
/// unanswered reports are auto-approved at approvalDeadline (48 h). Elo is applied only on
/// confirmation. The booking link is optional.
model Match {
  id               String             @id @default(cuid())
  clubId           String             @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  format           MatchFormat
  type             MatchType
  sport            Sport
  /// Tournament this match belongs to (TOURNAMENT matches that count for Elo).
  tournamentId     String?
  status           MatchStatus        @default(PENDING)
  /// Club-local date the match was played.
  playedOn         DateTime           @db.Date
  /// Needed for the Har-Tru vs Saibro head-to-head split, even without a court.
  surface          Surface
  courtId          String?
  bookingId        String?
  /// Winner implied by the sets; stored to keep win/loss queries simple.
  winnerSide       TeamSide
  reportedById     String
  reportedAt       DateTime           @default(now()) @db.Timestamptz(3)
  approvalDeadline DateTime           @db.Timestamptz(3)
  respondedById    String?
  respondedAt      DateTime?          @db.Timestamptz(3)
  disputeComment   String?
  confirmation     MatchConfirmation?
  confirmedAt      DateTime?          @db.Timestamptz(3)
  resolvedById     String?
  resolvedAt       DateTime?          @db.Timestamptz(3)
  resolutionNote   String?
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)

  club            Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  court           Court?           @relation(fields: [courtId], references: [id], onDelete: SetNull)
  booking         Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  reportedBy      User             @relation("MatchReportedBy", fields: [reportedById], references: [id], onDelete: Restrict)
  respondedBy     User?            @relation("MatchRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)
  resolvedBy      User?            @relation("MatchResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  tournament      Tournament?      @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  tournamentMatch TournamentMatch?
  players         MatchPlayer[]
  sets            MatchSet[]
  eloHistory      EloHistory[]

  @@index([clubId, status, approvalDeadline])
  @@index([clubId, playedOn])
  @@index([bookingId])
  @@index([tournamentId])
}

/// Player and team side (A or B). Singles has one player per side, doubles two.
model MatchPlayer {
  matchId String
  userId  String
  side    TeamSide

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([matchId, userId])
  @@index([userId])
}

/// One set of a match (tennis: best of 3). A deciding match tie-break stores points (e.g. 10-8).
/// CHECK: setNumber is 1–5 (the sport decides how many are valid) and scores are non-negative.
model MatchSet {
  matchId         String
  setNumber       Int
  sideAGames      Int
  sideBGames      Int
  isMatchTiebreak Boolean @default(false)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([matchId, setNumber])
}

/// Current rating of a player in one sport. Always equals the `after` of the player's latest
/// EloHistory row for that sport (or the club's initial rating before any match).
model PlayerRating {
  id        String   @id @default(cuid())
  clubId    String   @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  userId    String
  sport     Sport
  elo       Int
  /// Confirmed rated matches played in this sport.
  matches   Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sport])
  @@index([clubId, sport, elo])
}

/// Rating change for one player in one confirmed match.
/// CHECK: after = before + delta.
model EloHistory {
  id        String   @id @default(cuid())
  clubId    String   @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  userId    String
  matchId   String
  sport     Sport
  before    Int
  after     Int
  delta     Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  club  Club  @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  match Match @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@unique([userId, matchId])
  @@index([userId, sport, createdAt])
  @@index([matchId])
}

// ─── Guests & gate ──────────────────────────────────────────────────────────

/// Single-entry day pass for one visit date. The QR holds a signed token referencing this row,
/// never personal data. Entry flips status ACTIVE → USED atomically.
/// Personal data (LGPD): the document number is stored encrypted (AES-256-GCM, key from
/// DATA_ENCRYPTION_KEY) with a keyed hash for lookups; name and document are erased
/// (anonymizedAt) after the club's guestDataRetentionDays.
/// CHECK: guestName is set until the pass is anonymized.
model GuestPass {
  id             String            @id @default(cuid())
  clubId         String            @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  hostId         String
  /// Null once anonymized.
  guestName      String?
  documentType   GuestDocumentType
  /// Legacy plaintext from before encryption; emptied by the encrypt-legacy job. Always null for
  /// new rows; the column is dropped in a later migration.
  documentNumber String?
  /// Encrypted normalized document number ("v1:iv:tag:ciphertext").
  documentCipher String?
  /// HMAC-SHA256 of type + normalized number, for equality lookups (gate search, blocklist).
  documentHash   String?
  anonymizedAt   DateTime?         @db.Timestamptz(3)
  visitDate      DateTime          @db.Date
  /// Optional link to one of the host's bookings on visitDate.
  bookingId      String?
  status         GuestPassStatus   @default(ACTIVE)
  usedAt         DateTime?         @db.Timestamptz(3)
  cancelledAt    DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)

  club    Club          @relation(fields: [clubId], references: [id], onDelete: Restrict)
  host    User          @relation(fields: [hostId], references: [id], onDelete: Restrict)
  booking Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  scans   GateScanLog[]

  @@index([hostId, visitDate])
  @@index([clubId, documentHash])
  @@index([clubId, visitDate, status])
}

/// Guest document barred from entry. Lifting keeps the row (liftedAt) for accountability.
model GuestBlock {
  id             String            @id @default(cuid())
  clubId         String            @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  documentType   GuestDocumentType
  /// Legacy plaintext (see GuestPass.documentNumber).
  documentNumber String?
  documentCipher String?
  documentHash   String?
  anonymizedAt   DateTime?         @db.Timestamptz(3)
  reason         String?
  blockedById    String
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  liftedAt       DateTime?         @db.Timestamptz(3)
  liftedById     String?

  club      Club  @relation(fields: [clubId], references: [id], onDelete: Restrict)
  blockedBy User  @relation("GuestBlockBlockedBy", fields: [blockedById], references: [id], onDelete: Restrict)
  liftedBy  User? @relation("GuestBlockLiftedBy", fields: [liftedById], references: [id], onDelete: SetNull)

  @@index([clubId, documentHash])
}

/// Every gate scan, accepted or not.
model GateScanLog {
  id          String         @id @default(cuid())
  clubId      String         @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  /// Null when the token could not be matched to a pass.
  guestPassId String?
  scannedById String
  method      GateScanMethod
  result      GateScanResult
  scannedAt   DateTime       @default(now()) @db.Timestamptz(3)

  club      Club       @relation(fields: [clubId], references: [id], onDelete: Restrict)
  guestPass GuestPass? @relation(fields: [guestPassId], references: [id], onDelete: SetNull)
  scannedBy User       @relation(fields: [scannedById], references: [id], onDelete: Restrict)

  @@index([guestPassId])
  @@index([scannedAt])
}

// ─── Notifications ──────────────────────────────────────────────────────────

/// In-app notification. `payload` carries the data; the web app renders the pt-BR text.
model Notification {
  id        String           @id @default(cuid())
  clubId    String           @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  userId    String
  type      NotificationType
  payload   Json             @default("{}")
  readAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ── Tournaments & circuits (Phase 9.5) ──────────────────────────────────────

/// A season ranking made of tournaments (stages), per category; separate from the Elo ladder.
model Circuit {
  id          String   @id @default(cuid())
  clubId      String   @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  name        String
  season      String
  /// Points per placement: { CHAMPION, FINALIST, SEMIFINAL, QUARTERFINAL, ROUND_OF_16, ROUND_OF_32, PARTICIPATION }.
  pointsTable Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  club        Club              @relation(fields: [clubId], references: [id], onDelete: Restrict)
  categories  CircuitCategory[]
  tournaments Tournament[]

  @@index([clubId, season])
}

model CircuitCategory {
  id        String @id @default(cuid())
  clubId    String @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  circuitId String
  name      String
  sortOrder Int    @default(0)

  club                 Club                 @relation(fields: [clubId], references: [id], onDelete: Restrict)
  circuit              Circuit              @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  tournamentCategories TournamentCategory[]

  @@unique([circuitId, name])
}

model Tournament {
  id                   String           @id @default(cuid())
  clubId               String           @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  /// Unguessable id of the public read-only page (/t/<publicId>).
  publicId             String           @unique
  name                 String
  description          String           @default("")
  coverImageUrl        String?
  sponsorLogos         String[]         @default([])
  startDate            DateTime         @db.Date
  endDate              DateTime         @db.Date
  location             String           @default("")
  /// Courts the order of play may use; empty = every active court.
  courtIds             String[]         @default([])
  status               TournamentStatus @default(DRAFT)
  registrationOpensAt  DateTime?        @db.Timestamptz(3)
  registrationClosesAt DateTime?        @db.Timestamptz(3)
  allowGuests          Boolean          @default(false)
  feeAmountCents       Int?
  requiresApproval     Boolean          @default(false)
  restMinutes          Int              @default(60)
  circuitId            String?
  createdById          String
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)

  club          Club                     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  circuit       Circuit?                 @relation(fields: [circuitId], references: [id], onDelete: SetNull)
  createdBy     User                     @relation("TournamentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  organizers    TournamentOrganizer[]
  categories    TournamentCategory[]
  matches       TournamentMatch[]
  announcements TournamentAnnouncement[]
  ratedMatches  Match[]
  /// Days whose order of play was published (club-local dates).
  publishedDays TournamentScheduleDay[]

  @@index([clubId, status, startDate])
}

/// Members allowed to run one tournament (besides admins).
model TournamentOrganizer {
  tournamentId String
  userId       String

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tournamentId, userId])
  @@index([userId])
}

model TournamentScheduleDay {
  tournamentId String
  date         DateTime @db.Date
  publishedAt  DateTime @default(now()) @db.Timestamptz(3)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@id([tournamentId, date])
}

model TournamentCategory {
  id                String        @id @default(cuid())
  clubId            String        @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  tournamentId      String
  name              String
  entryType         MatchFormat
  drawFormat        DrawFormat
  groupSize         Int           @default(4)
  advancePerGroup   Int           @default(2)
  maxEntries        Int
  scoreFormat       ScoreFormat   @default(BEST_OF_3_MATCH_TIEBREAK)
  countsForElo      Boolean       @default(false)
  seeding           SeedingMethod @default(ELO)
  circuitCategoryId String?
  sortOrder         Int           @default(0)
  drawGeneratedAt   DateTime?     @db.Timestamptz(3)
  drawPublishedAt   DateTime?     @db.Timestamptz(3)
  championEntryId   String?       @unique
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)

  club            Club                     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  tournament      Tournament               @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  circuitCategory CircuitCategory?         @relation(fields: [circuitCategoryId], references: [id], onDelete: SetNull)
  champion        TournamentEntry?         @relation("CategoryChampion", fields: [championEntryId], references: [id], onDelete: SetNull)
  entries         TournamentEntry[]
  groups          TournamentGroup[]
  matches         TournamentMatch[]
  announcements   TournamentAnnouncement[]

  @@index([tournamentId])
}

model TournamentEntry {
  id            String        @id @default(cuid())
  clubId        String        @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  categoryId    String
  status        EntryStatus
  paymentStatus PaymentStatus @default(UNPAID)
  /// Manual seed set by the organizer (1 = top), overrides the rating order.
  seed          Int?
  note          String?
  /// { weekdayNotBefore, weekendNotBefore, unavailableDates }
  restrictions  Json
  createdById   String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  club       Club                    @relation(fields: [clubId], references: [id], onDelete: Restrict)
  category   TournamentCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  players    TournamentEntryPlayer[]
  groupSlots TournamentGroupMember[]
  championOf TournamentCategory?     @relation("CategoryChampion")
  matchesAsA TournamentMatch[]       @relation("EntryA")
  matchesAsB TournamentMatch[]       @relation("EntryB")
  wins       TournamentMatch[]       @relation("EntryWinner")

  @@index([categoryId, status])
}

/// A member (userId) or a guest / external player (name + phone).
model TournamentEntryPlayer {
  id         String    @id @default(cuid())
  entryId    String
  position   Int
  userId     String?
  guestName  String?
  guestPhone String?
  /// Doubles partner invitations stay null until accepted.
  acceptedAt DateTime? @db.Timestamptz(3)

  entry TournamentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User?           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([entryId, position])
  @@index([userId])
}

model TournamentGroup {
  id         String @id @default(cuid())
  clubId     String @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  categoryId String
  /// "A", "B"…
  name       String
  sortOrder  Int

  club     Club                    @relation(fields: [clubId], references: [id], onDelete: Restrict)
  category TournamentCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  members  TournamentGroupMember[]
  matches  TournamentMatch[]

  @@unique([categoryId, name])
}

model TournamentGroupMember {
  groupId  String
  entryId  String
  position Int

  group TournamentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entry TournamentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([groupId, entryId])
}

/// One match of a draw (group fixture or knockout node). The result lives here; a Match row is
/// added only when the category counts for Elo and every player is a member.
model TournamentMatch {
  id                 String          @id @default(cuid())
  clubId             String          @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  tournamentId       String
  categoryId         String
  stage              TournamentStage
  groupId            String?
  /// 1 = first round (knockout) or matchday (groups).
  round              Int
  position           Int
  entryAId           String?
  entryBId           String?
  /// Knockout: the match the winner moves on to, and which side it takes.
  nextMatchId        String?
  nextSide           TeamSide?
  winnerEntryId      String?
  outcome            MatchOutcome?
  resultStatus       ResultStatus    @default(NONE)
  /// [{ a, b, tiebreak }], side A (entry A) first.
  sets               Json            @default("[]")
  reportedById       String?
  reportedAt         DateTime?       @db.Timestamptz(3)
  approvalDeadline   DateTime?       @db.Timestamptz(3)
  confirmedById      String?
  confirmedAt        DateTime?       @db.Timestamptz(3)
  scheduledDate      DateTime?       @db.Date
  courtId            String?
  timeSlotId         String?
  /// When the organizer last notified the players of this match's slot.
  scheduleNotifiedAt DateTime?       @db.Timestamptz(3)
  overdueAlertedAt   DateTime?       @db.Timestamptz(3)
  ratedMatchId       String?         @unique
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)

  club        Club               @relation(fields: [clubId], references: [id], onDelete: Restrict)
  tournament  Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  category    TournamentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  group       TournamentGroup?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entryA      TournamentEntry?   @relation("EntryA", fields: [entryAId], references: [id], onDelete: SetNull)
  entryB      TournamentEntry?   @relation("EntryB", fields: [entryBId], references: [id], onDelete: SetNull)
  winner      TournamentEntry?   @relation("EntryWinner", fields: [winnerEntryId], references: [id], onDelete: SetNull)
  nextMatch   TournamentMatch?   @relation("Advance", fields: [nextMatchId], references: [id], onDelete: SetNull)
  feeders     TournamentMatch[]  @relation("Advance")
  reportedBy  User?              @relation("TournamentResultReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  confirmedBy User?              @relation("TournamentResultConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  court       Court?             @relation(fields: [courtId], references: [id], onDelete: SetNull)
  timeSlot    TimeSlot?          @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  ratedMatch  Match?             @relation(fields: [ratedMatchId], references: [id], onDelete: SetNull)
  occupancy   SlotOccupancy?

  @@unique([categoryId, stage, groupId, round, position])
  @@index([tournamentId, scheduledDate])
  @@index([clubId, resultStatus, scheduledDate])
}

model TournamentAnnouncement {
  id           String   @id @default(cuid())
  clubId       String   @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  tournamentId String
  categoryId   String?
  authorId     String
  body         String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  club       Club                @relation(fields: [clubId], references: [id], onDelete: Restrict)
  tournament Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  category   TournamentCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author     User                @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([tournamentId, createdAt])
}

/// A date where staff override the weekday rules: holiday, event, maintenance day.
model ScheduleException {
  id             String     @id @default(cuid())
  clubId         String     @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  date           DateTime   @db.Date
  closed         Boolean    @default(false)
  /// Start times used that day ("HH:mm" list); null keeps the weekday grid.
  slotTimes      Json?
  mode           CourtMode?
  closedCourtIds String[]   @default([])
  note           String?
  createdById    String?
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  club      Club  @relation(fields: [clubId], references: [id], onDelete: Restrict)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([clubId, date])
}

/// Free play: players on a court right now (ended by check-out, staff or the session limit).
model CourtCheckIn {
  id          String    @id @default(cuid())
  clubId      String    @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  courtId     String
  date        DateTime  @db.Date
  startedAt   DateTime  @default(now()) @db.Timestamptz(3)
  /// Automatic check-out.
  endsAt      DateTime  @db.Timestamptz(3)
  endedAt     DateTime? @db.Timestamptz(3)
  /// CHECKOUT, AUTO or STAFF.
  endedReason String?
  createdById String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  club      Club                 @relation(fields: [clubId], references: [id], onDelete: Restrict)
  court     Court                @relation(fields: [courtId], references: [id], onDelete: Restrict)
  createdBy User                 @relation("CheckInCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  players   CourtCheckInPlayer[]

  @@index([clubId, endedAt])
  @@index([courtId, endedAt])
}

model CourtCheckInPlayer {
  checkInId String
  userId    String

  checkIn CourtCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([checkInId, userId])
  @@index([userId])
}

/// Free play queue when every court is busy; the first in line gets a court for a few minutes.
model CourtQueueEntry {
  id             String      @id @default(cuid())
  clubId         String      @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  userId         String
  date           DateTime    @db.Date
  status         QueueStatus @default(WAITING)
  joinedAt       DateTime    @default(now()) @db.Timestamptz(3)
  offeredCourtId String?
  offeredAt      DateTime?   @db.Timestamptz(3)
  offerExpiresAt DateTime?   @db.Timestamptz(3)
  resolvedAt     DateTime?   @db.Timestamptz(3)

  club         Club   @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  offeredCourt Court? @relation(fields: [offeredCourtId], references: [id], onDelete: SetNull)

  @@index([clubId, date, status, joinedAt])
}

/// A member keeping a free court while they book it, or waiting in line for it. Not a claim on the
/// slot (that is SlotOccupancy, created with the booking): it only decides who may book it first.
/// One row per member; the holder of a slot is its row with `expiresAt` set (at most one, see the
/// partial unique index in the migration), the others wait in `createdAt` order.
model SlotHold {
  id         String    @id @default(cuid())
  clubId     String    @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  userId     String
  courtId    String
  date       DateTime  @db.Date
  timeSlotId String
  /// Set while this member holds the slot; null while waiting in line.
  expiresAt  DateTime? @db.Timestamptz(3)
  /// Waiting members ping while their screen is open; silent ones lose their place.
  lastSeenAt DateTime  @db.Timestamptz(3)
  createdAt  DateTime  @db.Timestamptz(3)

  club     Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  court    Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  timeSlot TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([courtId, date, timeSlotId, createdAt])
}

/// Editable group of permissions (Secretaria, Diretoria…).
model StaffRole {
  id          String   @id @default(cuid())
  clubId      String   @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  /// Default roles keep their key (SECRETARIA, DIRETORIA, PROFESSOR, SUPER_ADMIN).
  key         String?
  name        String
  description String   @default("")
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  club    Club            @relation(fields: [clubId], references: [id], onDelete: Restrict)
  members UserStaffRole[]

  @@unique([clubId, name])
  @@unique([clubId, key])
}

model UserStaffRole {
  userId String
  roleId String

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role StaffRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

/// Every staff action (mutating request by an admin, coach or gate account).
model AuditLog {
  id        String   @id @default(cuid())
  clubId    String   @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  actorId   String?
  /// "POST /freezes", "PATCH /members/:id/status"…
  action    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  club  Club  @relation(fields: [clubId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([clubId, createdAt])
  @@index([actorId, createdAt])
}

/// A booking player who did not show up, or cancelled inside the late-cancellation window.
model NoShow {
  id         String     @id @default(cuid())
  clubId     String     @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  userId     String
  bookingId  String
  kind       NoShowKind
  markedById String?
  note       String?
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)

  club     Club    @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user     User    @relation("NoShowUser", fields: [userId], references: [id], onDelete: Cascade)
  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  markedBy User?   @relation("NoShowMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([bookingId, userId])
  @@index([userId, createdAt])
}

/// Club news board ("Mural").
model NewsPost {
  id          String    @id @default(cuid())
  clubId      String    @default(dbgenerated("current_setting('app.club_id'::text, true)"))
  title       String
  body        String
  photoUrls   String[]  @default([])
  eventDate   DateTime? @db.Date
  pinned      Boolean   @default(false)
  authorId    String
  publishedAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  club      Club           @relation(fields: [clubId], references: [id], onDelete: Restrict)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  reactions NewsReaction[]
  reads     NewsRead[]

  @@index([clubId, deletedAt, pinned, publishedAt])
}

model NewsReaction {
  postId    String
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  post NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

model NewsRead {
  postId String
  userId String
  readAt DateTime @default(now()) @db.Timestamptz(3)

  post NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}
