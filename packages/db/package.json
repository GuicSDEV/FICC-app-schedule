{
  "name": "@ficc/db",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "generated"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "prisma generate && dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "clean": "rm -rf dist generated .turbo"
  },
  "dependencies": {
    "@prisma/client": "~6.19.3"
  },
  "devDependencies": {
    "@ficc/eslint-config": "workspace:*",
    "@ficc/shared": "workspace:*",
    "@ficc/typescript-config": "workspace:*",
    "@types/node": "^22.20.5",
    "argon2": "^0.44.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.5",
    "prisma": "~6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
